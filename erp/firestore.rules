rules_version = '2';

// GOLD ERA ERP — Cloud Firestore security rules.
// Every account signs in with a username; Firebase sees it as <username>@users.gold-era.local.
// 1) If you change ownerUsernames or userDomain in config.js, change OWNER below to match.
// 2) Publish in Firebase console → Firestore Database → Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner()  { return signedIn() && request.auth.token.email.lower() in ['admin@users.gold-era.local']; } // OWNER

    // Per-user access, written by the owner from Settings → Users.
    function accessPath() { return /databases/$(database)/documents/access/$(request.auth.uid); }
    function acc()     { return get(accessPath()).data; }
    function active()  { return signedIn() && exists(accessPath()) && acc().active == true; }
    function canRead(c)  { return isOwner() || (active() && c in acc().read); }
    function canWrite(c) { return isOwner() || (active() && c in acc().write); }
    function canSettings() { return isOwner() || (active() && acc().settings == true); }

    // Access records: a user reads only their own; only the owner changes them.
    match /access/{uid}   { allow read: if isOwner() || (signedIn() && request.auth.uid == uid); allow write: if isOwner(); }
    // Catalog, workers, prices, limits, names directory.
    match /settings/{doc} { allow read: if isOwner() || active(); allow write: if canSettings() || (isOwner()); }
    // Monthly expenses for the profit report.
    match /months/{ym}    { allow read: if canRead('months') || canSettings(); allow write: if canSettings(); }

    // Ledger (one collection per module, one document per day), orders and customers.
    // A user reads only the collections their pages need and writes only where they have "edit".
    match /{coll}/{docId} {
      allow read: if coll in ['bars','strips','casting','moves','sales','payments','counts','labels','sessions','evals','orders','customers','staff'] && canRead(coll);
      allow create, update: if coll in ['bars','strips','casting','moves','sales','payments','counts','labels','sessions','evals','orders','customers','staff'] && canWrite(coll);
      allow delete: if isOwner();
    }
  }
}
